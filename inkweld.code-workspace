{
  "folders": [
    {
      "name": "✨ Root",
      "path": "."
    },
    {
      "name": "⚙️ Backend",
      "path": "backend"
    },
    {
      "name": "🎨 Frontend",
      "path": "frontend"
    },
    {
      "name": "📚 Docs",
      "path": "docs"
    }
  ],
  "settings": {
    "files.exclude": {
      "frontend/": true,
      "backend/": true,
      "docs/": true
    },
    // Coverage Gutters configuration for multi-root workspace
    "coverage-gutters.coverageBaseDir": "**",
    "coverage-gutters.showLineCoverage": true,
    "coverage-gutters.showRulerCoverage": true,
    "coverage-gutters.showGutterCoverage": true,
    "typescript.tsdk": "🎨 Frontend/frontend/node_modules/typescript/lib",
    "jest.disabledWorkspaceFolders": ["✨ Root", "⚙️ Backend", "🎨 Frontend"],
    "github-actions.workflows.pinned.workflows": [

      ".github/workflows/ci.yml"
    ],
    "github-actions.workflows.pinned.refresh.enabled": true,
    "powershell.cwd": "✨ Root"
  }
}
