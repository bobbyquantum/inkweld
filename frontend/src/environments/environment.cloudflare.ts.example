/**
 * Cloudflare Production Environment
 *
 * Points to the Cloudflare Workers production backend.
 * This file is generated by: npm run cloudflare:setup
 *
 * Replace YOUR_SUBDOMAIN with your Cloudflare account subdomain.
 * Find it at: https://dash.cloudflare.com → Workers & Pages → Overview
 * It's shown as: <worker-name>.YOUR_SUBDOMAIN.workers.dev
 *
 * For custom domains (e.g., api.inkweld.app), update the URLs accordingly.
 */
export const environment = {
  production: true,
  apiUrl: 'https://inkweld-backend-prod.YOUR_SUBDOMAIN.workers.dev',
  wssUrl: 'wss://inkweld-backend-prod.YOUR_SUBDOMAIN.workers.dev',
  // Uncomment to show the setup screen (Browser / Cloud Sync / Server
  // choice) on first run instead of auto-connecting to the hosted apiUrl:
  // autoConfigure: false,
  /**
   * Cloud Sync provider app keys. These are public OAuth client identifiers
   * (they ship in the browser bundle). An empty key hides that provider from
   * the Cloud Sync setup option. Self-hosters register their own apps and set
   * their keys here or at runtime in the connection settings.
   */
  cloudSync: {
    dropbox: { appKey: '' },
  },
};
