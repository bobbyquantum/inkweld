  {
    "id": "gen-story-prompts",
    "name": "Story prompts",
    "icon": "lightbulb",
    "description": "A premise, a turn and a complication, for when you are stuck.",
    "category": "prompts",
    "template": "What if #subject# #event#, and #twist#?",
    "rules": [
      {
        "key": "subject",
        "entries": [
          {
            "text": "a cartographer with nothing left to map"
          },
          {
            "text": "the youngest of three heirs"
          },
          {
            "text": "a retired informer"
          },
          {
            "text": "the last keeper of a dying craft"
          },
          {
            "text": "a translator who no longer trusts the text"
          },
          {
            "text": "a healer who has run out of supplies"
          },
          {
            "text": "a courier carrying a sealed message"
          },
          {
            "text": "a rival who arrived first"
          },
          {
            "text": "the only person who kept the old records"
          },
          {
            "text": "someone who was never meant to be found"
          }
        ]
      },
      {
        "key": "event",
        "entries": [
          {
            "text": "found the door already open"
          },
          {
            "text": "was offered the one thing they had stopped asking for"
          },
          {
            "text": "learned the map had been wrong for a century"
          },
          {
            "text": "was asked to testify against a friend"
          },
          {
            "text": "inherited a debt they did not know existed"
          },
          {
            "text": "recognised the handwriting"
          },
          {
            "text": "returned to find the town rebuilt without them"
          },
          {
            "text": "was given one night to decide"
          }
        ]
      },
      {
        "key": "twist",
        "entries": [
          {
            "text": "no one else remembers it happening"
          },
          {
            "text": "the only witness is someone they wronged"
          },
          {
            "text": "the truth would cost them the person they came to save"
          },
          {
            "text": "they have done this before and forgotten"
          },
          {
            "text": "the deadline was never real"
          },
          {
            "text": "admitting it would end the arrangement that keeps everyone fed"
          },
          {
            "text": "the person who warned them was lying about something else"
          }
        ]
      }
    ]
  }
