# Cloudflare Pages headers for Angular SPA
# See: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Same base policy the Bun server sends (backend/src/utils/csp.ts; csp.spec.ts
  # fails if they drift). No inline scripts: the build turns off critical-CSS
  # inlining, which was the only source of one.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss: blob: data:; media-src 'self' data: blob: https:; worker-src 'self' blob:; frame-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  # Disable X-Frame-Options in favor of CSP frame-ancestors
  X-Frame-Options: SAMEORIGIN
  # Other security headers
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cache static assets aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Project templates change with every release — must not be cached
# (no-store definitively overrides the immutable /assets/* rule above)
/assets/project-templates/*
  Cache-Control: no-store

# version.txt changes every deploy — must not be cached immutably
/assets/version.txt
  Cache-Control: no-cache

# WASM files are pre-compressed with Brotli to fit under Cloudflare's 25MB limit
/assets/wasm/*.wasm
  Content-Encoding: br
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Don't cache the index.html, manifest, or service worker files (for updates)
# Use no-cache (revalidate always) instead of no-store so the service worker
# can still cache these via the Cache API for offline use.
/index.html
  Cache-Control: no-cache, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
/ngsw.json
  Cache-Control: no-cache, must-revalidate
/ngsw-worker.js
  Cache-Control: no-cache, must-revalidate
