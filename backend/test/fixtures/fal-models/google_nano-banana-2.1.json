        "about": "Nano Banana 2.1 is a text-to-image model that generates images from text descriptions."
      }
    },
    "components": {
      "securitySchemes": {
        "apiKeyAuth": {
          "type": "apiKey",
          "in": "header",
          "name": "Authorization",
          "description": "Fal Key"
        }
      },
      "schemas": {
        "QueueStatus": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "IN_QUEUE",
                "IN_PROGRESS",
                "COMPLETED"
              ]
            },
            "request_id": {
              "type": "string",
              "description": "The request id."
            },
            "response_url": {
              "type": "string",
              "description": "The response url."
            },
            "status_url": {
              "type": "string",
              "description": "The status url."
            },
            "cancel_url": {
              "type": "string",
              "description": "The cancel url."
            },
            "logs": {
              "type": "object",
              "description": "The logs.",
              "additionalProperties": true
            },
            "metrics": {
              "type": "object",
              "description": "The metrics.",
              "additionalProperties": true
            },
            "queue_position": {
              "type": "integer",
              "description": "The queue position."
            }
          },
          "required": [
            "status",
            "request_id"
          ]
        },
        "NanoBanana21Input": {
          "required": [
            "prompt"
          ],
          "title": "NanoBanana21TextToImageInput",
          "properties": {
            "seed": {
              "title": "Seed",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The seed for the random number generator."
            },
            "sync_mode": {
              "title": "Sync Mode",
              "default": false,
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "type": "boolean"
            },
            "safety_tolerance": {
              "description": "The safety tolerance level for content moderation. 1 is the most strict (blocks most content), 6 is the least strict.",
              "title": "Safety Tolerance",
              "enum": [
                "1",
                "2",
                "3",
                "4",
                "5",
                "6"
              ],
              "default": "4",
              "type": "string"
            },
            "num_images": {
              "maximum": 4,
              "title": "Number of Images",
              "minimum": 1,
              "default": 1,
              "description": "The number of images to generate.",
              "type": "integer"
            },
            "resolution": {
              "description": "The resolution of the image to generate.",
              "title": "Resolution",
              "enum": [
                "1K",
                "2K",
                "4K"
              ],
              "default": "1K",
              "type": "string"
            },
            "aspect_ratio": {
              "title": "Aspect Ratio",
              "anyOf": [
                {
                  "enum": [
                    "auto",
                    "21:9",
                    "16:9",
                    "3:2",
                    "4:3",
                    "5:4",
                    "1:1",
                    "4:5",
                    "3:4",
                    "2:3",
                    "9:16",
                    "4:1",
                    "1:4",
                    "8:1",
                    "1:8"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "auto",
              "description": "The aspect ratio of the generated image. Supports extreme ratios: 4:1, 1:4, 8:1, 1:8. Use \"auto\" to let the model decide based on the prompt."
            },
            "prompt": {
              "maxLength": 50000,
              "title": "Prompt",
              "examples": [
                "An action shot of a black lab swimming in an inground suburban swimming pool. The camera is placed meticulously on the water line, dividing the image in half, revealing both the dogs head above water holding a tennis ball in it's mouth, and it's paws paddling underwater."
              ],
              "description": "The text prompt to generate an image from.",
              "minLength": 3,
              "type": "string"
            },
            "thinking_level": {
              "title": "Thinking Level",
              "anyOf": [
                {
                  "enum": [
                    "minimal",
                    "medium",
                    "high"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "medium",
              "description": "How much the model reasons before generating. Higher levels can improve complex compositions and use more thinking tokens."
            },
            "limit_generations": {
              "description": "Experimental parameter to limit the number of generations from each round of prompting to 1. Set to `True` to to disregard any instructions in the prompt regarding the number of images to generate and ignore any intermediate images generated by the model. This may affect generation quality.",
              "title": "Limit Generations",
              "default": true,
              "type": "boolean"
            },
            "system_prompt": {
              "maxLength": 50000,
              "title": "System Prompt",
              "default": "",
              "description": "Optional system instruction that steers the model's persona and output style across the request. Leave blank to omit; when provided, it is sent as the system instruction to Gemini (or as a system message on OpenAI-compatible providers).",
              "type": "string"
            },
            "enable_web_search": {
              "title": "Enable Web Search",
              "default": false,
              "description": "Enable web search for the image generation task. This will allow the model to use the latest information from the web to generate the image.",
              "type": "boolean"
            },
            "output_format": {
              "title": "Output Format",
              "enum": [
                "jpeg",
                "png",
                "webp"
              ],
              "default": "png",
              "description": "The format of the generated image.",
              "type": "string"
            }
          },
          "x-fal-order-properties": [
            "prompt",
            "num_images",
            "seed",
            "aspect_ratio",
            "output_format",
            "safety_tolerance",
            "sync_mode",
            "system_prompt",
            "resolution",
            "limit_generations",
            "enable_web_search",
            "thinking_level"
          ],
          "type": "object"
        },
        "NanoBanana21Output": {
          "required": [
            "images",
            "description"
          ],
          "title": "NanoBanana21TextToImageOutput",
          "properties": {
            "description": {
              "title": "Description",
              "description": "The description of the generated images.",
              "type": "string"
            },
            "images": {
              "title": "Images",
              "examples": [
                [
                  {
                    "content_type": "image/png",
                    "file_name": "nano-banana-2-t2i-output.png",
                    "url": "https://storage.googleapis.com/falserverless/example_outputs/nano-banana-2-t2i-output.png"
                  }
                ]
              ],
              "items": {
                "$ref": "#/components/schemas/ImageFile"
              },
              "description": "The generated images.",
              "type": "array"
            }
          },
          "x-fal-order-properties": [
            "images",
            "description"
          ],
          "type": "object"
        },
        "ImageFile": {
          "required": [
            "url"
          ],
          "title": "ImageFile",
          "properties": {
            "file_name": {
              "title": "File Name",
              "examples": [
                "z9RV14K95DvU.png"
              ],
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The name of the file. It will be auto-generated if not provided."
            },
            "height": {
              "title": "Height",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The height of the image"
            },
            "width": {
              "title": "Width",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The width of the image"
            },
            "content_type": {
              "title": "Content Type",
              "examples": [
                "image/png"
              ],
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mime type of the file."
            },
            "file_size": {
              "title": "File Size",
              "examples": [
                4404019
              ],
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The size of the file in bytes."
            },
            "url": {
              "title": "Url",
              "description": "The URL where the file can be downloaded from.",
              "type": "string"
            }
          },
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size",
            "width",
            "height"
          ],
          "type": "object"
        }
      }
    },
