{
  "endpoint_id": "krea/v2/large/text-to-image",
  "metadata": {
    "display_name": "Krea 2 Large",
    "category": "text-to-image",
    "description": "Generate high-fidelity images from text with Krea 2 Large, supporting aspect ratio, creativity, seed controls, and optional style references.",
    "status": "active",
    "tags": [
      "text-to-image",
      "image-generation",
      "style-reference",
      "krea",
      "krea-2"
    ],
    "updated_at": "2026-06-30T18:57:25.450Z",
