#!/bin/sh
# Block direct pushes to main — all changes must go through a PR.
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo ""
  echo "❌ Direct push to 'main' is not allowed."
  echo ""
  echo "   Create a branch and open a PR instead:"
  echo "     git checkout -b fix/your-change-name"
  echo "     git push -u origin fix/your-change-name"
  echo ""
  echo "   If you need to bypass this for a genuine emergency:"
  echo "     git push --no-verify"
  echo ""
  exit 1
fi

# Validate conventional commit format for the commits this push brings in.
# Commits already on origin/main are skipped: they arrive in a branch through
# a merge of main and were checked when they landed there, so a long header on
# main must not block every branch that merges it. Merge commits are skipped
# too (commitlint ignores them anyway).
main_ref=refs/remotes/origin/main
git rev-parse --verify -q "$main_ref" >/dev/null || main_ref=

while read local_ref local_oid remote_ref remote_oid; do
  # Skip branch deletions
  [ "$local_oid" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    # New branch: the commits not yet on any remote.
    commits=$(git rev-list --no-merges "$local_oid" --not --remotes)
  else
    commits=$(git rev-list --no-merges "$remote_oid..$local_oid" ${main_ref:+--not "$main_ref"})
  fi

  for commit in $commits; do
    git log -1 --format=%B "$commit" | npx --no -- commitlint || {
      echo ""
      echo "   Commit $(git rev-parse --short "$commit") needs a conventional commit message."
      echo "   Fix commit messages or bypass with: git push --no-verify"
      echo ""
      exit 1
    }
  done
done
