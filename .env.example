# InkWeld Environment Configuration
# Copy this file to .env at the project root and update the values as needed
#
# The Bun server loads the FIRST .env it finds (files are not merged):
#   1. .env in the current working directory (backend/.env when run from backend/)
#   2. ../.env (the project root when run from backend/)
#   3. the repository root .env
#   4. ~/.inkweld/.env (user config directory; %APPDATA%\Inkweld\.env on Windows)
# Variables already set in the process environment always win over the file.
#
# Precedence for settings that are also editable under Admin -> Settings:
# a value saved there wins over the environment variable, which wins over the
# built-in default. Environment values are read live; they are never copied
# into the database.

#############################################
# Server Configuration
#############################################

# Server port (default: 8333)
PORT=8333

# Runtime environment (development/production). Anything other than
# development/test requires SESSION_SECRET; production additionally requires
# WEBAUTHN_RP_ID (see below). The Docker image sets NODE_ENV=production.
NODE_ENV=development

# Application version (set automatically in CI/CD)
INKWELD_VERSION=0.1.0

# Comma-separated list of every origin users open Inkweld from. Used for CORS
# and as the expected origin for passkey sign-in; the first entry is also the
# fallback public URL for email links. (default: http://localhost:4200)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8333

#############################################
# Frontend Serving
#############################################

# Whether to serve the embedded/bundled frontend (default: true)
# Set to 'false' to run in API-only mode (when hosting frontend separately)
# SERVE_FRONTEND=true

# Path to external frontend dist folder (optional)
# If set, serves frontend from this path instead of embedded assets
# FRONTEND_DIST=/app/frontend

#############################################
# Database Configuration
#############################################

# The Bun server always uses SQLite and Cloudflare Workers always use the D1
# database bound in wrangler.toml. DB_TYPE is accepted but does not change
# anything, so it is not listed here.

# SQLite database file path (default: <DATA_PATH>/inkweld.db). The Docker image
# sets it to /data/sqlite.db.
# DB_PATH=./data/inkweld.db

#############################################
# Data Storage
#############################################

# Base path for project data storage (default: ./data)
# LevelDB stores per-project Yjs documents here, along with uploaded media.
# The SQLite database also lives here unless DB_PATH is set.
DATA_PATH=./data

#############################################
# Authentication & Security
#############################################

# Secret key for session cookies and database encryption.
# Required for every NODE_ENV other than development/test; the server refuses
# to start without it. Must be at least 32 characters and unique per deployment.
# Never copy a value from documentation or examples — generate your own:
#   openssl rand -hex 32
# Left unset, development falls back to a well-known key (with a warning).
# SESSION_SECRET=

# Alternative: Use DATABASE_KEY for encryption (falls back to SESSION_SECRET)
# DATABASE_KEY=your-database-encryption-key

# Require admin approval for new user registrations (default: true)
# USER_APPROVAL_REQUIRED=true

# Ceiling on dynamically registered MCP OAuth clients (RFC 7591 registration
# is anonymous). At the cap, day-old clients that never obtained a session are
# pruned first; if the table is still full, registration returns 503.
# (default: 500)
# MCP_MAX_DYNAMIC_CLIENTS=500

# Trust X-Forwarded-For / X-Real-IP from a reverse proxy (default: false).
# Set to true ONLY when nginx, Caddy, Traefik, Cloudflare Tunnel etc. sits in
# front of this server and overwrites those headers. Off by default because
# otherwise any client can forge the header and pick its own login
# rate-limit bucket. The rightmost X-Forwarded-For entry is used.
# TRUST_PROXY=false

#############################################
# Passkeys (WebAuthn) & Passwordless Mode
#############################################

# Master switch for passkey support (default: true).
# When false, the passkey UI is hidden and the WebAuthn endpoints return 403.
# PASSKEYS_ENABLED=true

# Allow username/password sign-in (default: false — passwordless-first per
# NIST SP 800-63B Rev. 4). When false:
#   - /login returns 403 for password attempts
#   - registration omits the password field and immediately enrols a passkey
#   - the forgot-password / reset-password endpoints are disabled (403/404)
# Existing password hashes are preserved while disabled, so flipping this back
# on does not lock out previously-registered password users.
# PASSWORD_LOGIN_ENABLED=false

# Allow email-based account recovery (default: false). When passwords are
# disabled this enables a magic-link flow that lets a user enrol a NEW passkey
# from a verified email; existing passkeys are never removed by recovery.
# When passwords are enabled this powers the classic forgot-password emails.
# Requires SMTP / EMAIL_* settings to actually deliver the link.
# EMAIL_RECOVERY_ENABLED=false

# ─── SMTP / transactional email ─────────────────────────────────────────────
# Required by EMAIL_RECOVERY_ENABLED (passkey magic-link recovery + classic
# password resets) and by any other email feature. All values are also
# editable from /admin/settings, where a saved value wins over these env vars.
# Master switch — when false the email service short-circuits and recovery
# emails are silently skipped (the API still returns its enumeration-safe
# 200 response so attackers can't probe which addresses are registered).
# EMAIL_ENABLED=false
# SMTP host (e.g. smtp.sendgrid.net, smtp.gmail.com, smtp.mailgun.org)
# EMAIL_HOST=
# SMTP port — 587 for STARTTLS (default), 465 for implicit TLS, 25 for none
# EMAIL_PORT=587
# starttls | tls | none — must match the chosen port
# EMAIL_ENCRYPTION=starttls
# SMTP credentials (leave blank for unauthenticated relays inside a VPC)
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# Envelope From — must be a domain you're authorised to send from (SPF/DKIM)
# EMAIL_FROM=noreply@example.com
# Display name shown to recipients
# EMAIL_FROM_NAME=Inkweld

# WebAuthn Relying Party identifier — domain only, no protocol or port.
# CRITICAL: this cannot be changed once users have registered passkeys
# without invalidating every existing credential. Defaults to "localhost"
# in development, but the server REFUSES TO START with NODE_ENV=production
# (including the Docker image) when it is unset. In production this MUST match
# the public hostname users visit (and must be a registrable domain or exact
# match, per the WebAuthn spec — e.g. "app.example.com" or "example.com").
# WEBAUTHN_RP_ID=app.example.com

# Display name shown in the browser's passkey prompt (default: "Inkweld").
# WEBAUTHN_RP_NAME=Inkweld


#############################################
# Default Admin User (Optional)
#############################################

# Create a default admin user on startup (useful for bootstrapping)
# Both username and password must be set for the admin to be created
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=your-secure-admin-password

#############################################
# GitHub OAuth Configuration
#############################################

# Enable GitHub authentication (default: false)
GITHUB_ENABLED=false

# GitHub OAuth credentials (required if GITHUB_ENABLED=true)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub OAuth callback URL (optional, auto-generated from the request host if
# not set). Register this exact URL in your GitHub OAuth app:
# GITHUB_CALLBACK_URL=http://localhost:8333/api/v1/auth/github

#############################################
# AI Features (Optional)
#############################################

# OpenAI API key for AI features (optional)
# If not set, AI features (linting, image generation) will be disabled
# OPENAI_API_KEY=your-openai-api-key

#############################################
# Appearance (Login / Home Backgrounds)
#############################################

# All of these are also editable at runtime in Admin -> Appearance, which is
# the easier route: the uploaded images can only be managed there.
#
# Two surfaces are configured independently:
#   login - the pre-auth pages (welcome/sign-in, setup, approval-pending,
#           password and passkey recovery)
#   home  - the signed-in pages (home, create-project, user profile)
# An unset login background falls back to the home one, so uploading a single
# image brands both. Each surface resolves as:
#   uploaded image -> external URL -> the bundled default.

# External image URLs, used only when no image has been uploaded for the
# surface. Must be absolute https. Visitors load these directly from that
# host, so their IP address reaches it.
# LOGIN_BACKGROUND_URL=https://cdn.example.com/login-background.webp
# HOME_BACKGROUND_URL=https://cdn.example.com/home-background.webp

# Opacity (0-0.95) of the scrim drawn over the background so text stays
# readable. Leave unset to keep the per-theme defaults (0.5 dark / 0.7 light).
# BACKGROUND_OVERLAY_OPACITY=0.5

# Blur radius in pixels (0-40) applied to the background behind the scrim.
# 0 disables the effect entirely.
# BACKGROUND_BLUR=0

# Let users pick their own background from the built-in presets. Affects the
# signed-in pages only — the login background is always the admin's.
# (default: true)
# USER_BACKGROUND_ENABLED=true

# Let users upload their own background image (one slot each, stored
# server-side under DATA_PATH/backgrounds). Requires USER_BACKGROUND_ENABLED.
# Off by default because it consumes storage per user. (default: false)
# USER_BACKGROUND_UPLOAD_ENABLED=false

#############################################
# Sync Capacity (per-user storage quotas)
#############################################

# Refuse media uploads, published files and new projects once an account's
# server storage reaches its allowance. Editing and syncing existing work are
# never blocked. Usage is measured and shown either way. (default: false)
# SYNC_QUOTA_ENABLED=false

# Default allowance per user, in bytes. Admins can grant individual users more
# (or less) from Admin → Users → Storage. (default: 104857600 = 100 MB)
# SYNC_QUOTA_DEFAULT_BYTES=104857600

#############################################
# Application Mode (Frontend)
#############################################

# Application mode: ONLINE, LOCAL, or BOTH (default: BOTH)
# - ONLINE: Requires server connection (no local-only option)
# - LOCAL: Local mode only (no server connection option)
# - BOTH: User can choose either mode
APP_MODE=BOTH
